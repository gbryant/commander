#!/bin/bash
# Build @CMDR_APP@ and push via OTA.
# Usage: ./bum-ota [host]   default: @CMDR_OTA_HOST@
set -e

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST="${1:-@CMDR_OTA_HOST@}"
OTA_PORT=8000

echo "==> Building..."
"$DIR/build"

BIN="@CMDR_BUILD_DIR@/@CMDR_APP@_fota_image.bin"
[[ -f "$BIN" ]] || { echo "OTA image not found — is APP_USE_PFB ON in your app.cmake?"; exit 1; }

IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)
[[ -n "$IP" ]] || { echo "Could not determine local IP — check en0/en1."; exit 1; }
URL="http://$IP:$OTA_PORT/@CMDR_APP@_fota_image.bin"

python3 -m http.server "$OTA_PORT" --directory "@CMDR_BUILD_DIR@" &
SERVER_PID=$!
trap "kill $SERVER_PID 2>/dev/null; wait $SERVER_PID 2>/dev/null" EXIT
sleep 1

echo "==> Serving $URL"
echo "==> Connecting to $HOST..."
OTA_HOST="$HOST" OTA_URL="$URL" python3 "@CMDR_SCRIPTS@/ota_push.py"
echo "==> Done."

# Wait for the device to reboot onto the new firmware, then open a session.
echo "==> Waiting for $HOST to come back up..."
for _ in $(seq 1 60); do
    (exec 3<>"/dev/tcp/$HOST/23") 2>/dev/null && break
    sleep 1
done
echo "==> Opening telnet ($HOST) — Ctrl-] then 'quit' to exit"
telnet "$HOST"
