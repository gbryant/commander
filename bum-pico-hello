#!/bin/bash
set -e
REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
APP_UF2="$REPO_ROOT/platform/pico/build-pico-hello/commander.uf2"

cd "$REPO_ROOT/platform/pico"
cmake -B build-pico-hello -S . -DPICO_BOARD=pico_w -DCOMMANDER_APP=uart_hello \
    -DUART_TX_PIN=20 -DUART_RX_PIN=21
cmake --build build-pico-hello -j4

enter_bootsel() {
    PORT=$(python3 "$REPO_ROOT/scripts/find_port.py" pico 2>/dev/null || true)
    if [ -n "$PORT" ]; then
        python3 - "$PORT" <<'EOF'
import sys, serial, time
with serial.Serial(sys.argv[1], 115200, timeout=2) as s:
    time.sleep(0.1); s.write(b'bootloader\r\n'); time.sleep(0.5)
EOF
        for i in $(seq 1 20); do picotool info &>/dev/null && return 0; sleep 0.5; done
        echo "error: device did not enter BOOTSEL" >&2; exit 1
    else
        echo "No running device found. Hold BOOTSEL while plugging in, then press Enter."
        read -r
    fi
}

picotool info &>/dev/null || enter_bootsel
picotool load -f "$APP_UF2"
picotool reboot
echo "Done — Pico W sending hello world on UART1 GP20(TX)/GP21(RX) at 115200"
