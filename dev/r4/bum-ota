#!/bin/bash
# Build R4 firmware and push via OTA (ArduinoOTA, port 65280).
# Usage: dev/r4/bum-ota [host]   default host: commander-r4.local
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
HOST="${1:-r4.local}"

"$DIR/build"
(cd "$DIR/../.." && pio run -e r4 -t upload --upload-port "$HOST")
