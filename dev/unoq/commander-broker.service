[Unit]
Description=Commander channel-bus broker (ttyHS1 demux -> ch0 console on ttyGS0 + channel sockets)
Documentation=https://github.com/gbryant/commander docs/commander-channels-bringup.md
# Replaces commander-bridge.service. Like the bridge it carries the ch0 console to the USB-CDC
# gadget (ttyGS0 -> the Mac's /dev/cu.usbmodem*), but it ALSO demuxes the channel bus: chN ->
# /tmp/commander/chN.sock for local Debian consumers (e.g. ch1 = IR events).
#
# Requires:
#   - a channel-bus MCU firmware (built with -DCOMMANDER_ENABLE_CHANNELS); a plain-UART
#     console firmware will not deframe (use commander-bridge.service for that instead).
#   - ttyHS1 + ttyGS0 free: the arduino-router stack masked (see docs/unoq-access.md) and the
#     MCU booting from flash (option bytes — see docs/zephyr-hal-spike.md).
# Mutually exclusive with the bridge (they both own ttyHS1/ttyGS0).
After=adbd.service
Conflicts=commander-bridge.service

[Service]
# Script lives at /home/arduino/commander_broker.py (source of truth:
# transport/channels/broker/commander_broker.py in the repo). No pyserial needed (termios).
# User arduino is in the dialout group, so it can open ttyHS1/ttyGS0; running as arduino keeps
# the /tmp/commander/chN.sock sockets owned by arduino so other arduino processes can connect.
ExecStart=/usr/bin/python3 /home/arduino/commander_broker.py --port /dev/ttyHS1 --console /dev/ttyGS0 --channels 1,2,3
Restart=always
RestartSec=2
User=arduino

[Install]
WantedBy=multi-user.target
