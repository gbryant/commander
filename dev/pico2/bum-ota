#!/bin/bash
# Build Pico 2 W firmware and push via OTA.
# Usage: dev/pico2/bum-ota [host]   default host: pico2.local
set -e

REPO="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
HOST="${1:-pico2.local}"
OTA_PORT=8000

echo "==> Building..."
"$REPO/dev/pico2/build"

BIN="$REPO/platform/pico/build-pico2/commander_fota_image.bin"
[[ -f "$BIN" ]] || { echo "OTA image not found after build."; exit 1; }

IP=$(ipconfig getifaddr en0 2>/dev/null || ipconfig getifaddr en1 2>/dev/null || true)
[[ -n "$IP" ]] || { echo "Could not determine local IP — check en0/en1."; exit 1; }
URL="http://$IP:$OTA_PORT/commander_fota_image.bin"

python3 -m http.server "$OTA_PORT" --directory "$REPO/platform/pico/build-pico2" &
SERVER_PID=$!
trap "kill $SERVER_PID 2>/dev/null; wait $SERVER_PID 2>/dev/null" EXIT
sleep 1

echo "==> Serving $URL"
echo "==> Connecting to $HOST..."
OTA_HOST="$HOST" OTA_URL="$URL" python3 "$REPO/scripts/ota_push.py"
echo "==> Done."
