#!/bin/bash
# Upload the app over USB DFU — no ST-Link. Requires the one-time setup:
#   dev/bluepill/flash-bootloader   then   pio run -e bluepill-usb-dfu -t upload
# Before running this, put the board in DFU mode: type `bootloader` in the shell.
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$DIR/../.."
BIN=".pio/build/bluepill-usb-dfu/firmware.bin"

command -v dfu-util >/dev/null || { echo "error: dfu-util not found (brew install dfu-util)" >&2; exit 1; }

echo "Building app (linked @ 0x08001000) ..."
pio run -e bluepill-usb-dfu

if ! dfu-util -l 2>/dev/null | grep -qi "dead:ca5d"; then
  echo >&2
  echo "No DFU device (dead:ca5d) found. In the running commander shell, type:" >&2
  echo "    bootloader" >&2
  echo "then re-run dev/bluepill/upload-usb" >&2
  exit 1
fi

echo "Flashing $BIN over USB DFU ..."
# davidgfnet presents a DfuSe interface ("@Internal Flash ..."), so dfu-util needs the
# target address. App lives at 0x08001000; ":leave" exits DFU and boots it after download.
# (The "Invalid DFU suffix" warning is harmless — a raw .bin has no DFU suffix.)
dfu-util -d 0xdead:0xca5d -a 0 -s 0x08001000:leave -D "$BIN"
echo "Done — the board reboots into the new app."
