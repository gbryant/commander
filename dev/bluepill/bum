#!/bin/bash
# Build + upload (ST-Link). Optionally monitor: pass the USART1 adapter port as $1.
#   dev/bluepill/bum                         # build + flash
#   dev/bluepill/bum /dev/cu.usbserial-XXXX  # build + flash + open the USART1 console
set -e
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
"$DIR/build"
"$DIR/upload"
[ -n "$1" ] && "$DIR/monitor" "$1"
